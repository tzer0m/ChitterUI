@page "/"
@inject ChitterApiService ChitterApi
@inject QuoteService Quotes
@inject PackingListService PackingList
@inject GeofenceService Geofence
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Chitter</PageTitle>

<div class="receipt">
    <header class="receipt__header">
        <h1>Chitter</h1>
    </header>

    <div class="receipt__divider"></div>

    @if (LocationState == LocationCheckState.Allowed)
    {
        <div class="receipt__mode-toggle">
            <button type="button" class="receipt__mode-button @(IsImageMode ? "receipt__mode-button--active" : "")" disabled="@IsSending" @onclick="@(() => SetMode(true))">
                Image
            </button>
            <button type="button" class="receipt__mode-button @(!IsImageMode ? "receipt__mode-button--active" : "")" disabled="@IsSending" @onclick="@(() => SetMode(false))">
                Text
            </button>
        </div>

        <div class="receipt__divider"></div>

        @if (IsImageMode)
        {
            @if (PreviewDataUrl is not null)
            {
                <img class="receipt__preview" src="@PreviewDataUrl" alt="Selected image preview" />

                <div class="receipt__actions">
                    <button type="button" class="receipt__button" disabled="@IsSending" @onclick="PrintImageAsync">
                        @(IsSending ? "Printing..." : "Print")
                    </button>

                    <button type="button" class="receipt__button receipt__button--secondary" disabled="@IsSending" @onclick="ClearImage">
                        Choose Another
                    </button>
                </div>
            }
            else if (IsCameraActive)
            {
                <video id="@CameraVideoElementId" class="receipt__camera-preview" autoplay playsinline muted></video>

                <div class="receipt__actions">
                    <button type="button" class="receipt__button" @onclick="CapturePhotoAsync">
                        Capture
                    </button>

                    <button type="button" class="receipt__button receipt__button--secondary" @onclick="StopCameraAsync">
                        Cancel
                    </button>
                </div>
            }
            else
            {
                <div class="receipt__actions">
                    <button type="button" class="receipt__button" @onclick="StartCameraAsync">
                        Take Photo
                    </button>

                    <InputFile id="chitter-upload-input" OnChange="HandleImageSelected" accept="image/*" class="receipt__file-input" />
                    <label for="chitter-upload-input" class="receipt__button receipt__button--secondary">Upload File</label>
                </div>
            }
        }
        else
        {
            <textarea class="receipt__input" placeholder="Type something to print..." maxlength="1024" @bind="Text" @bind:event="oninput" disabled="@IsSending"></textarea>

            <div class="receipt__meta">
                <span>@Text.Length / 1024</span>
            </div>

            <div class="receipt__actions">
                <button type="button" class="receipt__button" disabled="@(IsSending || string.IsNullOrWhiteSpace(Text))" @onclick="PrintAsync">
                    @(IsSending ? "Printing..." : "Print")
                </button>
            </div>

            <div class="receipt__divider"></div>

            <div class="receipt__actions">
                <button type="button" class="receipt__button" disabled="@IsSending" @onclick="PrintProverbAsync">
                    @(IsSending ? "Printing..." : "Chinese Proverb")
                </button>

                <button type="button" class="receipt__button" disabled="@IsSending" @onclick="PrintQuoteAsync">
                    @(IsSending ? "Printing..." : "Motivational Quote")
                </button>

                <button type="button" class="receipt__button" disabled="@IsSending" @onclick="TogglePackingListOptions">
                    Packing List
                </button>
            </div>

            @if (ShowPackingListOptions)
            {
                <div class="receipt__checkbox-row">
                    <label class="receipt__checkbox-label">
                        <input type="checkbox" checked="@PackingListInternational" disabled="@IsSending" @onchange="OnInternationalChanged" />
                        International
                    </label>

                    <label class="receipt__checkbox-label">
                        <input type="checkbox" checked="@PackingListSkiing" disabled="@IsSending" @onchange="OnSkiingChanged" />
                        Skiing
                    </label>
                </div>

                <div class="receipt__actions">
                    <button type="button" class="receipt__button" disabled="@IsSending" @onclick="PrintPackingListAsync">
                        @(IsSending ? "Printing..." : "Print Packing List")
                    </button>
                </div>
            }
        }

        <div class="receipt__divider"></div>

        @if (StatusMessage is not null)
        {
            <p class="receipt__status @(IsError ? "receipt__status--error" : "receipt__status--success")">@StatusMessage</p>
        }
    }
    else
    {
        <p class="receipt__status">@LocationStateMessage</p>
    }

    <div class="receipt__barcode"></div>
</div>

@code {
    /// <summary>
    /// The text currently entered in the print box.
    /// </summary>
    private string Text = string.Empty;

    /// <summary>
    /// Whether the image-print form is showing, as opposed to the text-print form.
    /// </summary>
    private bool IsImageMode = true;

    /// <summary>
    /// The bytes of the currently-selected image, or null if none is selected.
    /// </summary>
    private byte[]? ImageBytes;

    /// <summary>
    /// The original file name of the currently-selected image.
    /// </summary>
    private string? ImageFileName;

    /// <summary>
    /// The content type of the currently-selected image.
    /// </summary>
    private string? ImageContentType;

    /// <summary>
    /// A data URL for the currently-selected image, used to preview it before printing.
    /// </summary>
    private string? PreviewDataUrl;

    /// <summary>
    /// Whether the live webcam preview is currently showing (desktop browsers, which don't route <input capture> to a camera, use this instead).
    /// </summary>
    private bool IsCameraActive;

    /// <summary>
    /// The id of the <video> element the webcam preview is rendered into.
    /// </summary>
    private const string CameraVideoElementId = "chitter-camera-video";

    /// <summary>
    /// The camera.js module, imported lazily on first use.
    /// </summary>
    private IJSObjectReference? CameraModule;

    /// <summary>
    /// Whether the packing list's International/Skiing checkboxes are showing.
    /// </summary>
    private bool ShowPackingListOptions;

    /// <summary>
    /// Whether the packing list's International section should be included.
    /// </summary>
    private bool PackingListInternational;

    /// <summary>
    /// Whether the packing list's Skiing section should be included - ticking this also ticks International, since skiing trips are always international here.
    /// </summary>
    private bool PackingListSkiing;

    /// <summary>
    /// Whether a print request is currently in flight.
    /// </summary>
    private bool IsSending;

    /// <summary>
    /// The most recent status message to show the user, or null if none yet.
    /// </summary>
    private string? StatusMessage;

    /// <summary>
    /// Whether StatusMessage represents an error rather than a success.
    /// </summary>
    private bool IsError;

    /// <summary>
    /// The current state of the browser geolocation check that gates the whole form.
    /// </summary>
    private LocationCheckState LocationState = LocationCheckState.Checking;

    /// <summary>
    /// The states the location check can be in.
    /// </summary>
    private enum LocationCheckState
    {
        Checking,
        Allowed,
        Denied,
        Unavailable,
    }

    /// <summary>
    /// A user-facing message describing the current LocationState, shown in place of the form.
    /// </summary>
    private string LocationStateMessage => LocationState switch
    {
        LocationCheckState.Checking => "Checking your location...",
        LocationCheckState.Denied => "Chitter only works from home.",
        _ => "Couldn't get your location - check your browser's location permission and try again.",
    };

    /// <summary>
    /// Requests the browser's location on first render and checks it against the configured home geofence.
    /// </summary>
    /// <param name="firstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        IJSObjectReference geolocationModule = await JS.InvokeAsync<IJSObjectReference>("import", "./geolocation.js");
        GeoPosition? position = await geolocationModule.InvokeAsync<GeoPosition?>("getPosition");

        LocationState = position is null ? LocationCheckState.Unavailable : Geofence.IsWithinRange(position.Latitude, position.Longitude) ? LocationCheckState.Allowed : LocationCheckState.Denied;
        StateHasChanged();
    }

    /// <summary>
    /// Switches between the image and text print forms, clearing any status message from the previous mode.
    /// </summary>
    /// <param name="imageMode">True to switch to the image form, false to switch to the text form.</param>
    private async Task SetMode(bool imageMode)
    {
        if (!imageMode && IsCameraActive)
            await StopCameraAsync();

        IsImageMode = imageMode;
        StatusMessage = null;
    }

    /// <summary>
    /// Starts the live webcam preview, for browsers (mainly desktop) that don't route <input capture> to a camera.
    /// </summary>
    private async Task StartCameraAsync()
    {
        StatusMessage = null;
        IsCameraActive = true;
        StateHasChanged();

        CameraModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./camera.js");
        bool started = await CameraModule.InvokeAsync<bool>("startCamera", CameraVideoElementId);
        if (!started)
        {
            IsCameraActive = false;
            IsError = true;
            StatusMessage = "Couldn't access your camera - check the browser's camera permission.";
        }
    }

    /// <summary>
    /// Grabs a still frame from the live webcam preview as the selected image, then stops the camera.
    /// </summary>
    private async Task CapturePhotoAsync()
    {
        if (CameraModule is null)
            return;

        string? dataUrl = await CameraModule.InvokeAsync<string?>("capturePhoto", CameraVideoElementId);
        if (dataUrl is null)
        {
            IsError = true;
            StatusMessage = "Couldn't capture a photo - try again.";
            return;
        }

        int commaIndex = dataUrl.IndexOf(',');
        string contentType = dataUrl[5..commaIndex].Split(';')[0];
        ImageBytes = Convert.FromBase64String(dataUrl[(commaIndex + 1)..]);
        ImageFileName = "camera.jpg";
        ImageContentType = contentType;
        PreviewDataUrl = dataUrl;

        await StopCameraAsync();
    }

    /// <summary>
    /// Stops the live webcam preview and releases the camera.
    /// </summary>
    private async Task StopCameraAsync()
    {
        if (CameraModule is not null)
            await CameraModule.InvokeVoidAsync("stopCamera", CameraVideoElementId);

        IsCameraActive = false;
    }

    /// <summary>
    /// Reads the file picked from the upload input into memory and builds a preview for it.
    /// </summary>
    /// <param name="e">The file-change event.</param>
    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        IBrowserFile file = e.File;
        StatusMessage = null;

        try
        {
            using MemoryStream stream = new();
            await file.OpenReadStream(UploadLimits.MaxImageSizeBytes).CopyToAsync(stream);

            ImageBytes = stream.ToArray();
            ImageFileName = file.Name;
            ImageContentType = file.ContentType;
            PreviewDataUrl = $"data:{ImageContentType};base64,{Convert.ToBase64String(ImageBytes)}";
        }
        catch (IOException)
        {
            IsError = true;
            StatusMessage = "That image is too large - try a smaller photo.";
        }
    }

    /// <summary>
    /// Clears the currently-selected image, returning to the picker.
    /// </summary>
    private void ClearImage()
    {
        ImageBytes = null;
        ImageFileName = null;
        ImageContentType = null;
        PreviewDataUrl = null;
    }

    /// <summary>
    /// Sends the current text to tzer0mApi's Chitter endpoint, clearing the text box on success.
    /// </summary>
    private async Task PrintAsync()
    {
        string text = Text;
        bool success = await SendToPrinterAsync(() => ChitterApi.PrintTextAsync(text));
        if (success)
            Text = string.Empty;
    }

    /// <summary>
    /// Sends the currently-selected image to tzer0mApi's Chitter endpoint, clearing it on success.
    /// </summary>
    private async Task PrintImageAsync()
    {
        if (ImageBytes is null || ImageFileName is null || ImageContentType is null)
            return;

        byte[] bytes = ImageBytes;
        string fileName = ImageFileName;
        string contentType = ImageContentType;
        bool success = await SendToPrinterAsync(() => ChitterApi.PrintImageAsync(new MemoryStream(bytes), fileName, contentType));
        if (success)
            ClearImage();
    }

    /// <summary>
    /// Picks a random motivational quote and prints it, formatted as "quote" followed by the author.
    /// </summary>
    private async Task PrintQuoteAsync()
    {
        MotivationalQuote quote = Quotes.GetRandomQuote();
        string text = $"\"{quote.Quote}\"\n\n— {quote.Author}";
        await SendToPrinterAsync(() => ChitterApi.PrintTextAsync(text));
    }

    /// <summary>
    /// Picks a random Chinese proverb and prints it, with the Chinese text followed by its English translation.
    /// </summary>
    private async Task PrintProverbAsync()
    {
        ChineseProverb proverb = Quotes.GetRandomProverb();
        string text = $"{proverb.Chinese}\n{proverb.English}";
        await SendToPrinterAsync(() => ChitterApi.PrintTextAsync(text));
    }

    /// <summary>
    /// Shows or hides the packing list's International/Skiing checkboxes.
    /// </summary>
    private void TogglePackingListOptions() => ShowPackingListOptions = !ShowPackingListOptions;

    /// <summary>
    /// Handles the International checkbox changing - unticking it also unticks Skiing, since Skiing implies International.
    /// </summary>
    /// <param name="e">The checkbox's change event.</param>
    private void OnInternationalChanged(ChangeEventArgs e)
    {
        PackingListInternational = e.Value is true;
        if (!PackingListInternational)
            PackingListSkiing = false;
    }

    /// <summary>
    /// Handles the Skiing checkbox changing - ticking it also ticks International, since skiing trips are always international here.
    /// </summary>
    /// <param name="e">The checkbox's change event.</param>
    private void OnSkiingChanged(ChangeEventArgs e)
    {
        PackingListSkiing = e.Value is true;
        if (PackingListSkiing)
            PackingListInternational = true;
    }

    /// <summary>
    /// Builds and prints the packing list, including the International/Skiing sections per the current checkboxes.
    /// </summary>
    private async Task PrintPackingListAsync()
    {
        string text = PackingList.BuildText(PackingListInternational, PackingListSkiing);
        await SendToPrinterAsync(() => ChitterApi.PrintTextAsync(text));
    }

    /// <summary>
    /// Runs a print action against tzer0mApi, tracking the in-flight state and reporting the outcome.
    /// </summary>
    /// <param name="sendAction">The print call to make.</param>
    /// <returns>True if the print job was accepted, false otherwise.</returns>
    private async Task<bool> SendToPrinterAsync(Func<Task<ChitterPrintResult>> sendAction)
    {
        IsSending = true;
        StatusMessage = null;
        StateHasChanged();
        ChitterPrintResult result = await sendAction();
        IsSending = false;
        IsError = !result.Success;
        StatusMessage = result.Success ? "Sent to printer." : result.ErrorMessage;
        return result.Success;
    }

    /// <summary>
    /// Releases the camera if the live preview is still active when this component goes away.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (CameraModule is null)
            return;

        try
        {
            await CameraModule.InvokeVoidAsync("stopCamera", CameraVideoElementId);
            await CameraModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone - nothing left to clean up.
        }
    }
}