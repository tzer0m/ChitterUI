@page "/"
@inject ChitterApiService ChitterApi
@inject QuoteService Quotes

<PageTitle>Chitter</PageTitle>

<div class="receipt">
    <header class="receipt__header">
        <h1>Chitter</h1>
    </header>

    <div class="receipt__divider"></div>

    <textarea class="receipt__input" placeholder="Type something to print..." maxlength="1024" @bind="Text" @bind:event="oninput" disabled="@IsSending"></textarea>

    <div class="receipt__meta">
        <span>@Text.Length / 1024</span>
    </div>

    <div class="receipt__actions">
        <button type="button" class="receipt__button" disabled="@(IsSending || string.IsNullOrWhiteSpace(Text))" @onclick="PrintAsync">
            @(IsSending ? "Printing..." : "Print")
        </button>
    </div>

    <div class="receipt__divider"></div>

    <div class="receipt__actions">
        <button type="button" class="receipt__button" disabled="@IsSending" @onclick="PrintProverbAsync">
            @(IsSending ? "Printing..." : "Chinese Proverb")
        </button>

        <button type="button" class="receipt__button" disabled="@IsSending" @onclick="PrintQuoteAsync">
            @(IsSending ? "Printing..." : "Motivational Quote")
        </button>
    </div>

    <div class="receipt__divider"></div>


    @if (StatusMessage is not null)
    {
        <p class="receipt__status @(IsError ? "receipt__status--error" : "receipt__status--success")">@StatusMessage</p>
    }

    <div class="receipt__barcode"></div>
</div>

@code {
    // The text currently entered in the print box.
    private string Text = string.Empty;

    // Whether a print request is currently in flight.
    private bool IsSending;

    // The most recent status message to show the user, or null if none yet.
    private string? StatusMessage;

    // Whether StatusMessage represents an error rather than a success.
    private bool IsError;

    /// <summary>
    /// Sends the current text to tzer0mApi's Chitter endpoint, clearing the text box on success.
    /// </summary>
    private async Task PrintAsync()
    {
        bool success = await SendToPrinterAsync(Text);
        if (success)
            Text = string.Empty;
    }

    /// <summary>
    /// Picks a random motivational quote and prints it, formatted as "quote" followed by the author.
    /// </summary>
    private async Task PrintQuoteAsync()
    {
        MotivationalQuote quote = Quotes.GetRandomQuote();
        await SendToPrinterAsync($"\"{quote.Quote}\"\n\n\u2014 {quote.Author}");
    }

    /// <summary>
    /// Picks a random Chinese proverb and prints it, with the Chinese text followed by its English translation.
    /// </summary>
    private async Task PrintProverbAsync()
    {
        ChineseProverb proverb = Quotes.GetRandomProverb();
        await SendToPrinterAsync($"{proverb.Chinese}\n{proverb.English}");
    }

    /// <summary>
    /// Sends text to the printer.
    /// </summary>
    /// <param name="text">The text to print.</param>
    /// <returns>True if the print job was accepted, false otherwise.</returns>
    private async Task<bool> SendToPrinterAsync(string text)
    {
        IsSending = true;
        StatusMessage = null;
        StateHasChanged();
        ChitterPrintResult result = await ChitterApi.PrintTextAsync(text);
        IsSending = false;
        IsError = !result.Success;
        StatusMessage = result.Success ? "Sent to printer." : result.ErrorMessage;
        return result.Success;
    }
}